# 职责：APK 签名配置模板，复制为 keystore.properties 并填入真实值（该文件被 .gitignore 忽略）

# 生成自己的密钥库（正式发布务必替换，口令请用 ≥16 位随机串）：
#   keytool -genkeypair -v -keystore my-release.jks -alias mykey \
#     -keyalg RSA -keysize 4096 -validity 10000 -storetype PKCS12
# 生成随机口令（示例）：
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))"

# 也可完全不写本文件，改用环境变量（推荐用于 CI，口令不落文件）：
#   CHECKIN_STORE_FILE / CHECKIN_STORE_PASSWORD / CHECKIN_KEY_ALIAS / CHECKIN_KEY_PASSWORD

# 密钥库文件路径（相对项目根目录，或使用绝对路径）
storeFile=my-release.jks
# 密钥库口令
storePassword=改成你自己的强口令
# 密钥别名
keyAlias=checkin
# 密钥口令（PKCS12 库中与库口令一致）
keyPassword=改成你自己的强口令
